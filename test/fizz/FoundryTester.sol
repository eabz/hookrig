    // forge test --match-test test_smoke_handlers -vvv
    /// @notice Smoke test: the main handler paths must succeed from the setup state (not silently revert).
    function test_smoke_handlers() public {
        pool_swap_clamped(POOL_MULTI, true, true, 100 ether, 0, address(0));
        vm.roll(block.number + 1);
        pool_swap_clamped(POOL_MULTI, false, true, 100 ether, 0, address(0));
        pool_swap_clamped(POOL_UNREGISTERED, true, false, 10 ether, 3, address(0));
        pool_addLiquidity_clamped(POOL_MULTI, 0, 1_000 ether, 0, address(0));
        vm.roll(block.number + 5);
        pool_removeLiquidity_full(POOL_MULTI, 0, 0, address(0));
        hookRigOrchestrator_placeLimitOrder_clamped(POOL_MULTI, 2, true, 10 ether, false);
        hookRigOrchestrator_cancelLimitOrder_clamped(0);
        hookRigOrchestrator_withdrawClaim_full(POOL_MULTI, 0, 1); // Bob: tax recipient
        virtualXYKLaunch_buy_clamped(0, 10 ether, address(0));
        virtualXYKLaunch_sell_full(0);
        virtualXYKLaunch_buy_toGraduation(0);
        assertTrue(_isPoolLive(POOL_XYK), "XYK should graduate");
        pool_swap_clamped(POOL_XYK, true, true, 1 ether, 0, address(0));
        steppedTrancheLaunch_buy_toGraduation(0);
        assertTrue(_isPoolLive(POOL_TRANCHE), "Tranche should graduate");
        launchpadFactory_secondary(0, 1, 1_000 ether, 0);
        // Registering on the live POOL_UNREGISTERED (`secondary(0, 2, ...)`) is removed: it trips SP-19 by design
        // (retro-registration of an initialized pool, documented finding ADV-13 / E-5). Register a fresh key instead.
        hookRigOrchestrator_secondary(0, 1794, 1, 1, 0, address(0)); // fresh dynamic-fee key, tick spacing 7
        assertEq(poolKeys.length, 7, "fresh registration should add a pool");
    }

    // ── Violation Repros (auto-generated by Step 11) ──────────────────
    // Each test_repro_* function below replays a shrunk fuzzer call
    // sequence that violated a property. Run all with:
    //   forge test --match-contract FoundryTester -vvv

    /// @dev Replays one fuzzer call with its raw calldata; reverts in setup steps are tolerated, as in the fuzzer.
    function _replay(bytes memory callData) internal {
        (bool ok,) = address(this).call(callData);
        ok;
    }

    /// @dev Verifies that after fixing the finding, the final call of a shrunk repro sequence no longer triggers a Panic.
    function _expectAssertionFailure(bytes memory callData) internal {
        (bool ok, bytes memory ret) = address(this).call(callData);
        if (callData.length == 4) {
            assertTrue(ok, "global property should hold after fix");
            return;
        }
        if (!ok && ret.length >= 4) {
            bytes4 sel;
            assembly {
                sel := mload(add(ret, 32))
            }
            assertTrue(sel != bytes4(0x4e487b71), "unexpected Panic in repro sequence");
        }
    }

